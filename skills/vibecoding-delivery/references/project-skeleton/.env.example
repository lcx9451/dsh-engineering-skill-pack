# 环境变量样例 —— 复制为 .env 使用，.env 永不入库
# 规则：只放"名字 + 占位值 + 说明"；任何真实凭证、密钥、连接串都不得出现在本文件

# 运行环境：local | test | staging | prod
NODE_ENV=local

# 服务端口
PORT=3000

# 数据库（本地用容器，staging/prod 由 Secret Manager 注入）
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>

# 鉴权（密钥必须由 Secret Manager 生成并轮换，禁止手写可猜测值）
AUTH_JWT_SECRET=<由密钥管理系统注入>
AUTH_TOKEN_TTL_SECONDS=3600

# 可观测性：日志级别 trace|debug|info|warn|error
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=<留空则关闭导出>
OTEL_SERVICE_NAME=<service-name>

# 第三方服务（示例，按需增删）
# THIRD_PARTY_API_BASE_URL=
# THIRD_PARTY_API_KEY=<由密钥管理系统注入>

# ---- 填写检查（提交前确认）----
# [ ] 没有任何真实密钥/口令/令牌
# [ ] 每个变量在 docs/architecture.md 或 README 中有说明用途
# [ ] 每个变量在环境矩阵（docs/release-checklist.md）四个环境中都有归属
